# Base URL of the deployed Modal API, without a trailing slash.
# `modal deploy -m modal_app.deploy` prints it; it looks like
# https://<workspace>--voice-convert-api.modal.run
#
# Server-side only. It reaches the browser through /api/config at request time,
# never through the build, so the same build works against any deployment.
MODAL_API_URL=https://your-workspace--voice-convert-api.modal.run

# Optional. Where a takedown or misuse report goes; rendered on /terms.
# Left empty, the terms page says a contact has not been published yet rather
# than printing a dead link.
CONTACT_EMAIL=

# RVC mode (docs/rvc-mode.md). Ba URL riêng, in ra ở cuối log
# `modal deploy modal_rvc.py`. Để trống thì /api/rvc/* trả 500 kèm tên biến
# còn thiếu — phần còn lại của app vẫn chạy bình thường.
MODAL_RVC_CONVERT_URL=
MODAL_RVC_LIST_URL=
MODAL_RVC_ADD_URL=
