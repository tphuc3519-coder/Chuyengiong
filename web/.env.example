# Base URL of the deployed Modal API, without a trailing slash.
# `modal deploy -m modal_app.deploy` prints it; it looks like
# https://<workspace>--voice-convert-api.modal.run
#
# Server-side only. It reaches the browser through /api/config at request time,
# never through the build, so the same build works against any deployment.
MODAL_API_URL=https://your-workspace--voice-convert-api.modal.run
